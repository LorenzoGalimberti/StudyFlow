{
  "expo": {
    "name": "Remembro",
    "slug": "remembro",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingofthepond.remembro",
      "infoPlist": {
        "NSCameraUsageDescription": "Remembro ha bisogno di accedere alla fotocamera per scattare foto delle tue nozioni.",
        "NSPhotoLibraryUsageDescription": "Remembro ha bisogno di accedere alle tue foto per aggiungere immagini alle nozioni."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#3B82F6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kingofthepond.remembro",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SCHEDULE_EXACT_ALARM"
        
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Remembro ha bisogno di accedere alle tue foto per aggiungere immagini alle nozioni.",
          "cameraPermission": "Remembro ha bisogno di accedere alla fotocamera per scattare foto delle nozioni."
        }
      ],
      "@react-native-firebase/app"
    ],
    "extra": {
      "eas": {
        "projectId": "6559c7a1-1786-49e9-ac83-8baa7e6e05cb"
      }
    }
  }
}
